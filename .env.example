# Copy to .env and edit:  cp .env.example .env
# Keep simple KEY=value lines (no quotes, no "export") so systemd can read it too.

# ---- Shared secret between Streamlit and the gateway ----
GATEWAY_KEY=change-me-to-a-long-random-string

# ---- Where things listen ----
LLAMA_URL=http://127.0.0.1:8080
GATEWAY_URL=http://127.0.0.1:8000
LLAMA_PORT=8080

# ---- Gateway limits ----
# Max requests in flight (running + queued inside llama-server). Extra requests get HTTP 429.
MAX_INFLIGHT=12
# Hard cap on tokens generated per reply
MAX_TOKENS_CAP=512
# Requests allowed per browser session per minute
RATE_LIMIT_PER_MIN=20
# Only the newest N messages of a chat are sent to the model (keeps each request inside its slot's context)
MAX_MESSAGES=12
MAX_CHARS_PER_MESSAGE=4000
SYSTEM_PROMPT=You are a helpful, concise assistant running locally on an NVIDIA Jetson Orin Nano.
# Shown in the UI and /health
MODEL_LABEL=Llama 3.2 3B Instruct Q4_K_M

# ---- Frontend ----
# Leave empty for no password. Set one before sharing a public link.
APP_PASSWORD=
MAX_HISTORY_MESSAGES=6

# ---- Paths used by scripts/ (adjust if your folders differ) ----
LLAMA_CPP_DIR=/home/jetson3/ECHS_PRAC2/llama.cpp
MODELS_DIR=/home/jetson3/ECHS_PRAC2/models
VENV_DIR=/home/jetson3/ECHS_PRAC2/venv
